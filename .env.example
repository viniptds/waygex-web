# Copy to .env for local development (the server reads ./.env when NODE_ENV is not
# "production"). In Coolify, set these in the resource's Environment Variables tab.

# Port the Node server listens on. The Docker image defaults to 3000.
PORT=3000

# Public origin, used for canonical/hreflang/Open Graph URLs and links in emails. No trailing slash.
SITE_URL=https://waygex.com

# Resend API key (https://resend.com/api-keys). Without it, POST /api/contact answers
# 503 {"ok":false,"error":"not_configured"}; in development the would-be emails are
# printed to the server console instead.
RESEND_API_KEY=

# Sender for both emails. The domain (waygex.com here) MUST be verified in Resend
# (Domains -> Add domain -> add the DNS records), otherwise Resend rejects the send.
RESEND_FROM=Waygex <hello@waygex.com>

# Where new briefs are delivered. Comma-separated for several inboxes.
# The first address is also the Reply-To of the visitor's confirmation email.
CONTACT_TO=contact@waygex.com

# Set to "false" to stop sending the confirmation email to the visitor.
SEND_CONFIRMATION=true

# Google Tag Manager container id (GTM-XXXXXXX). Leave empty to disable.
GTM_TAG=
